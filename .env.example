# =============================================================
# Personal AI Content Agent — Google-Powered Workflow
# =============================================================

# -------------------------------------------------------------
# Google Gemini (Google AI Pro Subscription)
# Get your API Key from Google AI Studio: https://aistudio.google.com/
# -------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# -------------------------------------------------------------
# Twitter / X Collection (Playwright with cookies.json)
# -------------------------------------------------------------
# Mode: "auto", "playwright", or "mock"
# Default "auto" runs authenticated Playwright scraping using cookies.json
COLLECTOR_MODE=auto

PLAYWRIGHT_HEADLESS=True
COOKIES_FILE=cookies.json
USER_DATA_DIR=userdata

# Scraping Limits
TWEETS_PER_ACCOUNT=2
MAX_TWEET_AGE_HOURS=24

# -------------------------------------------------------------
# Telegram Bot (Human-in-the-Loop Review - Steps 1 & 7)
# -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -------------------------------------------------------------
# Slack Incoming Webhook (Optional notification channel)
# -------------------------------------------------------------
SLACK_WEBHOOK_URL=

# -------------------------------------------------------------
# Instagram Direct Auto-Posting (Method B - instagrapi)
# -------------------------------------------------------------
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=


# -------------------------------------------------------------
# Server Settings (FastAPI + LangGraph Orchestrator)
# -------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Prioritization Thresholds (0 - 100)
HIGH_PRIORITY_THRESHOLD=75.0
MEDIUM_PRIORITY_THRESHOLD=50.0
TOP_NEWS_LIMIT=5

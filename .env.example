# =============================================================
# Personal AI Content Agent — Google-Powered Workflow
# =============================================================

# -------------------------------------------------------------
# Google Gemini (Google AI Pro Subscription)
# Get your API Key from Google AI Studio: https://aistudio.google.com/
# -------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# -------------------------------------------------------------
# Twitter / X Collection (Playwright with cookies.json)
# -------------------------------------------------------------
# Mode: "auto", "playwright", or "mock"
# Default "auto" runs authenticated Playwright scraping using cookies.json
COLLECTOR_MODE=auto

PLAYWRIGHT_HEADLESS=True
COOKIES_FILE=cookies.json
USER_DATA_DIR=userdata

# Scraping Limits
TWEETS_PER_ACCOUNT=2
MAX_TWEET_AGE_HOURS=24

# -------------------------------------------------------------
# Slack Incoming Webhook (Optional notification channel)
# -------------------------------------------------------------
SLACK_WEBHOOK_URL=

# -------------------------------------------------------------
# LinkedIn (multi-image posts)
# -------------------------------------------------------------
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_API_VERSION=202509

# YouTube Shorts upload reuses the Google OAuth below (youtube.upload scope)
YOUTUBE_PRIVACY=public

# -------------------------------------------------------------
# Google Workspace OAuth (Drive / Calendar / Gmail for Alfred)
# -------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/callback

# -------------------------------------------------------------
# Instagram Direct Auto-Posting (Method B - instagrapi)
# -------------------------------------------------------------
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=


# -------------------------------------------------------------
# Server Settings (FastAPI + LangGraph Orchestrator)
# -------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Prioritization Thresholds (0 - 100)
HIGH_PRIORITY_THRESHOLD=75.0
MEDIUM_PRIORITY_THRESHOLD=50.0
TOP_NEWS_LIMIT=5

# --- HeyGen (avatar videos) ---
# Only HEYGEN_API_KEY is required: HeyGen -> Settings -> API -> copy the key. No restart needed.
# AVATAR_ID / VOICE_ID may stay empty: Alfred then uses your own digital twin and its default voice.
# Check the setup:  python -m src.studio
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
# Avatar engine: avatar_iii (cheapest, ~$1/min) | avatar_iv | avatar_v (best quality)
HEYGEN_ENGINE=avatar_iii

# --- Groq (backup AI when Gemini quota runs out) ---
# Free key: https://console.groq.com -> API Keys. Optional; no restart needed.
GROQ_API_KEY=

# --- Top half of split-screen videos ---
# wan = Alibaba Wan 2.6 Flash ($0.025/s silent 720p, 50 s free) | omni_flash = Gemini Omni Flash | kenburns = free zoom/pan
TOP_VIDEO_ENGINE=wan
TOP_VIDEO_RESOLUTION=720p

# --- Wan 2.6 Flash (top half of videos) ---
# WaveSpeed AI (works from India): wavespeed.ai -> sign in -> API Keys. $0.025/s at 720p silent.
WAVESPEED_API_KEY=
# Alternative: Alibaba Cloud Model Studio (not available for India accounts)
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=

# --- OpenAI GPT Image (optional 2nd choice; skipped while the key is empty) ---
# Key: platform.openai.com -> API keys (needs API billing). ~$0.01 per medium image.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_QUALITY=medium

# --- Images: first choice (uses WAVESPEED_API_KEY above) ---
# bytedance/seedream-v5.0-flash (~$0.027/image) | wavespeed-ai/qwen-image/text-to-image (~$0.02)
WAVESPEED_IMAGE_MODEL=bytedance/seedream-v5.0-flash
WAVESPEED_IMAGE_RESOLUTION=2k
